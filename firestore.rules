rules_version = '2';
// Aturan keamanan Firestore untuk aplikasi WASHLY - Simplify the Flow.
// Daftar email admin harus sama dengan adminEmails di auth-config.js (huruf kecil).
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['denekijulianto@gmail.com', 'eki_julianto@pmi.or.id'];
    }
    // Penunjukan petugas (pemeriksa, penyetuju, surveyor, penggambar) tidak berubah — hanya pemilik/admin yang boleh mengubahnya
    function sameCrew() {
      return request.resource.data.get('checkerUid', '') == resource.data.get('checkerUid', '')
        && request.resource.data.get('approverUid', '') == resource.data.get('approverUid', '')
        && request.resource.data.get('surveyorUid', '') == resource.data.get('surveyorUid', '')
        && request.resource.data.get('drafterUid', '') == resource.data.get('drafterUid', '');
    }
    // ---- Langganan (WASHLY PRO). Semua dokumen di bawah ini HANYA ditulis oleh Cloud Functions (Admin SDK),
    // sehingga pengguna tidak bisa mengubah paket/hak aksesnya sendiri dari aplikasi.
    function billingOn() {
      return exists(/databases/$(database)/documents/billing_config/main)
        && get(/databases/$(database)/documents/billing_config/main).data.get('enforce', false) == true;
    }
    function isPro(uid) {
      return exists(/databases/$(database)/documents/entitlements/$(uid))
        && get(/databases/$(database)/documents/entitlements/$(uid)).data.get('tier', 'FREE') == 'PRO'
        && get(/databases/$(database)/documents/entitlements/$(uid)).data.get('accessUntilTs', null) != null
        && get(/databases/$(database)/documents/entitlements/$(uid)).data.accessUntilTs > request.time;
    }
    // Batas proyek cloud paket FREE (jumlah dihitung server di usage/{uid})
    function underFreeLimit(uid) {
      return get(/databases/$(database)/documents/usage/$(uid)).data.get('cloudProjects', 0)
        < get(/databases/$(database)/documents/billing_config/main).data.freeLimits.cloudProjects;
    }
    function mayCreateProject(uid) {
      return isAdmin() || !billingOn() || isPro(uid)
        || !exists(/databases/$(database)/documents/usage/$(uid)) && get(/databases/$(database)/documents/billing_config/main).data.freeLimits.cloudProjects > 0
        || exists(/databases/$(database)/documents/usage/$(uid)) && underFreeLimit(uid);
    }
    function approved() {
      return isAdmin() || (request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved');
    }
    // Profil pengguna & persetujuan akun
    match /users/{uid} {
      // pengguna yang disetujui boleh melihat daftar pengguna (untuk memilih pemeriksa & penyetuju)
      allow read: if request.auth != null && (request.auth.uid == uid || approved());
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
      // pengguna boleh menghapus akunnya sendiri (fitur "Hapus akun", wajib Google Play)
      allow delete: if request.auth != null && request.auth.uid == uid;
      // pengguna boleh memperbarui namanya sendiri (dari profil)
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
    }
    // Profil petugas (alamat, asal organisasi, riwayat penugasan, foto): hanya pemilik & admin
    match /profiles/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Daftar proyek (ringkasan) — semua anggota yang disetujui boleh membaca
    match /projects/{pid} {
      allow read: if approved();
      allow create: if approved() && request.resource.data.ownerUid == request.auth.uid
        && (isAdmin() || !(request.resource.data.status in ['checked', 'approved']))
        && mayCreateProject(request.auth.uid);
      // Pemilik (status tetap / belum disetujui), admin, atau petugas yang ditunjuk (hanya langkahnya, tanpa mengubah penunjukan)
      allow update: if approved()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (isAdmin()
          || (resource.data.ownerUid == request.auth.uid
              && (request.resource.data.status == resource.data.status || !(request.resource.data.status in ['checked', 'approved'])))
          || (resource.data.get('checkerUid', '') == request.auth.uid && sameCrew()
              && request.resource.data.status in ['review', 'checked', 'revisi'])
          || ((resource.data.get('surveyorUid', '') == request.auth.uid || resource.data.get('drafterUid', '') == request.auth.uid) && sameCrew()
              && request.resource.data.status == resource.data.status && resource.data.status in ['draft', 'revisi'])
          || (resource.data.get('approverUid', '') == request.auth.uid && sameCrew()
              && request.resource.data.status in ['review', 'checked', 'approved', 'revisi']));
      allow delete: if approved() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }
    // Isi lengkap proyek (terkompresi)
    match /projectData/{pid} {
      allow read: if approved();
      allow create: if approved() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if approved() && request.resource.data.ownerUid == resource.data.ownerUid
        && (resource.data.ownerUid == request.auth.uid || isAdmin()
          || get(/databases/$(database)/documents/projects/$(pid)).data.get('checkerUid', '') == request.auth.uid
          || get(/databases/$(database)/documents/projects/$(pid)).data.get('approverUid', '') == request.auth.uid
          || get(/databases/$(database)/documents/projects/$(pid)).data.get('surveyorUid', '') == request.auth.uid
          || get(/databases/$(database)/documents/projects/$(pid)).data.get('drafterUid', '') == request.auth.uid);
      allow delete: if approved() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }
    // Foto asesmen (resolusi penuh): anggota yang disetujui boleh melihat; hanya pengunggah/admin yang boleh mengubah/menghapus
    match /photos/{id} {
      allow read: if approved();
      allow create: if approved() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if approved() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }
    // ---- Langganan: baca saja untuk pemilik/admin; tulis hanya oleh server
    match /billing_config/{doc} {
      allow read: if true;          // harga & daftar fitur untuk halaman harga (tanpa data rahasia)
      allow write: if false;        // diubah lewat fungsi adminBillingConfig (tervalidasi & tercatat)
    }
    match /entitlements/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }
    match /usage/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }
    match /subscriptions/{id} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /payments/{id} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /subscription_events/{id} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    // Rahasia server: token pembelian Google Play, log webhook, audit admin
    match /play_tokens/{id} { allow read, write: if false; }
    match /webhook_events/{id} { allow read: if isAdmin(); allow write: if false; }
    match /admin_audit/{id} { allow read: if isAdmin(); allow write: if false; }
    // Kotak masuk notifikasi: pengirim = pengguna yang login; hanya penerima yang boleh membaca/menandai
    match /notifications/{id} {
      allow create: if request.auth != null && request.resource.data.fromUid in [request.auth.uid, '']
        && (approved() || request.resource.data.kind == 'register');
      allow read, update, delete: if request.auth != null && request.auth.token.email != null
        && resource.data.toEmail == request.auth.token.email.lower();
    }
  }
}
